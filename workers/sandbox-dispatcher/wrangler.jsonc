{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-24",
  "compatibility_flags": ["nodejs_compat"],

  // Per-issue ephemeral container that runs codex / claude / gh inside the sandbox.
  // The Dockerfile snapshot target is /home/node (auth + tool state).
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 100
    }
  ],

  // The Sandbox Durable Object class is re-exported from `@cloudflare/sandbox`
  // by `src/index.ts`. The DO uses SQLite-backed storage (new_sqlite_classes
  // in the migrations block below).
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"]
    }
  ],

  // R2 bucket that backs `Sandbox.createBackup({...})` snapshots.
  // Create with: wrangler r2 bucket create symphony-sandbox-backups
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "symphony-sandbox-backups"
    }
  ],

  // D1 database mapping `scope -> backup handle`. See migrations/0001_init.sql.
  // Create with: wrangler d1 create symphony-dispatcher
  // Then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "symphony-dispatcher",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Secrets — set with `wrangler secret put <NAME>`:
  //   DISPATCH_HMAC_SECRET     — HMAC-SHA256 key shared with Symphony for /run, /auth/* requests
  //   R2_ACCESS_KEY_ID         — R2 S3-compatible access key (for backup TTL inspection)
  //   R2_SECRET_ACCESS_KEY     — R2 S3-compatible secret key
  //   CLOUDFLARE_ACCOUNT_ID    — for R2 endpoint construction
  //   BACKUP_BUCKET_NAME       — informational; matches r2_buckets.bucket_name above

  "env": {
    "dev": {
      "name": "sandbox-dispatcher-dev",
      "containers": [
        {
          "class_name": "Sandbox",
          "image": "./Dockerfile",
          "instance_type": "standard-2",
          "max_instances": 10
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "Sandbox",
            "class_name": "Sandbox"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Sandbox"]
        }
      ],
      "r2_buckets": [
        {
          "binding": "BACKUP_BUCKET",
          "bucket_name": "symphony-sandbox-backups-dev"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "symphony-dispatcher-dev",
          "database_id": "REPLACE_WITH_DEV_DATABASE_ID",
          "migrations_dir": "migrations"
        }
      ]
      // Dev secrets — set with `wrangler secret put <NAME> --env dev`:
      //   DISPATCH_HMAC_SECRET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
      //   CLOUDFLARE_ACCOUNT_ID, BACKUP_BUCKET_NAME
    }
  }
}
