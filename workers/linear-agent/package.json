{
  "name": "linear-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "build": "npm run build:dashboard && wrangler deploy --dry-run --outdir=dist",
    "build:dashboard": "cd dashboard && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250314.0",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.14.0"
  }
}
