{
  "name": "linear-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "build": "npm run build:dashboard && wrangler deploy --dry-run --outdir=dist",
    "build:dashboard": "cd dashboard && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.10",
    "better-auth": "^1.6.10",
    "better-auth-cloudflare": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "liquidjs": "^10.25.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.5.0-beta.13",
    "@cloudflare/workers-types": "^4.20250314.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "~5.9.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.14.0"
  }
}
