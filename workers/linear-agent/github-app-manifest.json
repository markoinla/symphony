{
  "name": "Symphony",
  "description": "Agent orchestration — creates branches, opens PRs, and manages issues on behalf of your team.",
  "url": "https://github.com/markoinla/symphony",
  "hook_attributes": {
    "url": "https://linear-agent.symphonyapp.dev/webhook/github",
    "active": true
  },
  "redirect_url": "https://linear-agent.symphonyapp.dev/github/install/callback",
  "setup_url": "https://linear-agent.symphonyapp.dev/github/install/callback",
  "setup_on_update": true,
  "public": false,
  "default_permissions": {
    "contents": "write",
    "pull_requests": "write",
    "metadata": "read",
    "issues": "read"
  },
  "default_events": [
    "installation",
    "installation_repositories",
    "push",
    "pull_request"
  ]
}
